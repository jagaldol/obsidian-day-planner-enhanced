    "effect": "^3.22.2",
    "fraction.js": "4.3.7",
    "immer": "^11.1.18",
    "lucide-svelte": "^1.0.1",
    "luxon": "^3.7.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "moment-timezone": "^0.6.4",
    "node-ical": "0.18.0",
    "obsidian": "^1.13.1",
    "obsidian-daily-notes-interface": "^0.9.5",
    "svelte": "^5.57.0",
    "svelte-portal": "^2.2.1",
    "tinygesture": "^3.0.1",
    "ts-pattern": "^5.9.0",
    "typed-assert": "^1.0.9",
    "zod": "^4.6.5"
  },
  "overrides": {
    "axios": "1.18.0",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "uuid": "11.1.1"
  }
